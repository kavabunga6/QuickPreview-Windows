<Window x:Class="QuickPreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="QuickPreview" Icon="assets/quickpreview.ico"
        Width="1040" Height="720" MinWidth="520" MinHeight="340"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="True"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text,Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="58" CornerRadius="14" GlassFrameThickness="0"
                  ResizeBorderThickness="7" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Border Background="{DynamicResource WindowBackgroundBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="14">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="*" />
        <RowDefinition Height="64" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="14,14,0,0">
        <Grid Margin="20,0,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="FileNameText" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="FileMetaText" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Content="&#xE711;"
                  ToolTip="Закрыть (Esc)" Click="CloseButton_Click"
                  WindowChrome.IsHitTestVisibleInChrome="True" />
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="{DynamicResource PreviewBackgroundBrush}"
              BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1" ClipToBounds="True">
        <Grid>
          <Grid x:Name="LoadingView">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="◌" FontSize="46" HorizontalAlignment="Center"
                         Foreground="{DynamicResource AccentBrush}" />
              <TextBlock Text="Готовим превью…" Margin="0,12,0,0"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Grid>

          <Grid x:Name="ImageView" Visibility="Collapsed" Background="{DynamicResource ImageBackgroundBrush}"
                SizeChanged="ImageView_SizeChanged">
            <ScrollViewer x:Name="ImageScrollViewer"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                          PanningMode="Both" PanningDeceleration="0.001"
                          PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel">
              <Border x:Name="ImagePanSurface" Padding="22,22,22,86" Background="Transparent"
                      PreviewMouseLeftButtonDown="ImagePanSurface_MouseLeftButtonDown"
                      PreviewMouseMove="ImagePanSurface_MouseMove"
                      PreviewMouseLeftButtonUp="ImagePanSurface_MouseLeftButtonUp"
                      LostMouseCapture="ImagePanSurface_LostMouseCapture">
                <Image x:Name="PreviewImage" Stretch="Fill"
                       RenderOptions.BitmapScalingMode="HighQuality" />
              </Border>
            </ScrollViewer>

            <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18"
                    Padding="6" CornerRadius="16"
                    Background="{DynamicResource PlayerBarBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Button Width="38" Height="38" Padding="0" FontSize="20" Content="−"
                        ToolTip="Уменьшить" Click="ImageZoomOutButton_Click" />
                <TextBlock x:Name="ImageZoomText" Width="62" Text="100%"
                           TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Typography.NumeralAlignment="Tabular" />
                <Button Width="38" Height="38" Padding="0" FontSize="19" Content="+"
                        ToolTip="Увеличить" Click="ImageZoomInButton_Click" />
                <Border Width="1" Margin="7,7" Background="{DynamicResource CardBorderBrush}" />
                <Button Height="38" Padding="12,0" Content="100%"
                        ToolTip="Настоящий размер" Click="ImageActualSizeButton_Click" />
                <Button Height="38" Margin="6,0,0,0" Padding="14,0" Content="Вписать"
                        ToolTip="Вписать изображение в окно" Click="ImageFitButton_Click" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid x:Name="TextView" Visibility="Collapsed">
            <TextBox x:Name="PreviewText" IsReadOnly="True" BorderThickness="0"
                     Background="{DynamicResource CardBackgroundBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}" Padding="28,24"
                     FontFamily="Cascadia Mono,Consolas" FontSize="13.5"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                     TextWrapping="NoWrap" AcceptsReturn="True" />
          </Grid>

          <Grid x:Name="PdfView" Visibility="Collapsed" Background="#F3F3F3">
            <wv2:WebView2 x:Name="PdfWebView" />
          </Grid>

          <Grid x:Name="VideoView" Visibility="Collapsed" Background="#050506">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="76" />
            </Grid.RowDefinitions>
            <MediaElement x:Name="VideoMedia" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                          Stretch="Uniform" ScrubbingEnabled="True"
                          MediaOpened="ActiveMedia_MediaOpened" MediaEnded="ActiveMedia_MediaEnded"
                          MediaFailed="ActiveMedia_MediaFailed" />
            <Border Grid.Row="1" Margin="18,0,18,14" Padding="10,4" CornerRadius="18"
                    Background="{DynamicResource PlayerBarBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="96" />
                  <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Button x:Name="VideoPlayPauseButton" Style="{StaticResource PrimaryTransportButtonStyle}"
                        Content="&#xE769;" Click="PlayPauseButton_Click" />
                <Slider x:Name="VideoPositionSlider" Grid.Column="1" Margin="12,0,18,0"
                        VerticalAlignment="Center" Minimum="0"
                        PreviewMouseLeftButtonDown="MediaSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="MediaSlider_PreviewMouseLeftButtonUp"
                        ValueChanged="MediaPositionSlider_ValueChanged" />
                <TextBlock x:Name="VideoTimeText" Grid.Column="2" Text="0:00 / 0:00"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="12" Typography.NumeralAlignment="Tabular" />
                <Slider x:Name="VideoVolumeSlider" Grid.Column="3" Minimum="0" Maximum="1" Value="0.8"
                        SmallChange="0.05" LargeChange="0.1" Margin="4,0,8,0" VerticalAlignment="Center"
                        ToolTip="Громкость" PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseWheel="VolumeSlider_PreviewMouseWheel" />
                <Button x:Name="VideoMuteButton" Grid.Column="4" Content="&#xE767;"
                        Style="{StaticResource TransportButtonStyle}" ToolTip="Выключить звук"
                        Click="MuteButton_Click" />
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="AudioView" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="*" />
              <RowDefinition Height="94" />
            </Grid.RowDefinitions>

            <Grid Margin="86,30,86,22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="58" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="224" Height="224" CornerRadius="28"
                      Background="{DynamicResource CardBackgroundBrush}"
                      BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <Border x:Name="AudioArtworkBorder" Margin="18" CornerRadius="22"
                        Background="{DynamicResource AccentSoftBrush}">
                  <TextBlock x:Name="AudioFallbackIcon" Text="♪" FontFamily="Segoe UI Symbol" FontSize="112"
                             Foreground="{DynamicResource AccentBrush}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-8,0,0" />
                </Border>
              </Border>

              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="AudioTitleText" FontSize="27" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="AudioFormatText" Margin="0,8,0,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <Border Height="1" Margin="0,26,0,22" Background="{DynamicResource CardBorderBrush}" />
                <TextBlock Text="Продолжительность" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock x:Name="AudioDurationHeroText" Text="—:—" Margin="0,4,0,0"
                           FontSize="34" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
              </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="18,0,18,16" Padding="12,5" CornerRadius="20"
                    Background="{DynamicResource PlayerBarBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="50" />
                  <ColumnDefinition Width="68" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="68" />
                  <ColumnDefinition Width="112" />
                  <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <Button Content="−15" Style="{StaticResource TransportButtonStyle}" FontFamily="Segoe UI"
                        FontSize="12" ToolTip="Назад на 15 секунд" Click="SkipBackwardButton_Click" />
                <Button x:Name="AudioPlayPauseButton" Grid.Column="1"
                        Style="{StaticResource PrimaryTransportButtonStyle}"
                        Content="&#xE769;" Click="PlayPauseButton_Click" />
                <Button Grid.Column="2" Content="+15" Style="{StaticResource TransportButtonStyle}"
                        FontFamily="Segoe UI" FontSize="12" ToolTip="Вперёд на 15 секунд"
                        Click="SkipForwardButton_Click" />
                <TextBlock x:Name="AudioTimeText" Grid.Column="3" Text="0:00"
                           VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,12,0"
                           FontSize="13" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextPrimaryBrush}" />
                <Slider x:Name="AudioPositionSlider" Grid.Column="4" VerticalAlignment="Center" Minimum="0"
                        PreviewMouseLeftButtonDown="MediaSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseLeftButtonUp="MediaSlider_PreviewMouseLeftButtonUp"
                        ValueChanged="MediaPositionSlider_ValueChanged" />
                <TextBlock x:Name="AudioDurationText" Grid.Column="5" Text="0:00"
                           VerticalAlignment="Center" Margin="12,0,0,0" FontSize="13"
                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Slider x:Name="AudioVolumeSlider" Grid.Column="6" Minimum="0" Maximum="1" Value="0.8"
                        SmallChange="0.05" LargeChange="0.1" Margin="4,0,8,0" VerticalAlignment="Center"
                        ToolTip="Громкость" PreviewMouseLeftButtonDown="VolumeSlider_PreviewMouseLeftButtonDown"
                        PreviewMouseWheel="VolumeSlider_PreviewMouseWheel" />
                <Button x:Name="AudioMuteButton" Grid.Column="7" Content="&#xE767;"
                        Style="{StaticResource TransportButtonStyle}" ToolTip="Выключить звук"
                        Click="MuteButton_Click" />
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="InfoView" Visibility="Collapsed">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700"
                    Padding="34" CornerRadius="22" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
              <StackPanel>
                <Image x:Name="InfoThumbnail" Width="220" Height="220" Stretch="Uniform"
                       HorizontalAlignment="Center" Margin="0,0,0,20" />
                <TextBlock x:Name="InfoTitle" FontSize="23" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="InfoDetails" Margin="0,11,0,0" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                           TextWrapping="Wrap" LineHeight="21" />
              </StackPanel>
            </Border>
          </Grid>

          <Grid x:Name="ErrorView" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620">
              <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="!" FontSize="30" FontWeight="Bold"
                           Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock x:Name="ErrorText" Margin="0,14,0,0" TextAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>

        </Grid>
      </Border>

      <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" CornerRadius="0,0,14,14">
        <Grid Margin="18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Button Content="Открыть" Click="OpenButton_Click" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="←/→ файлы  ·  Space/Esc закрыть"
                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                     HorizontalAlignment="Stretch" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                     Margin="12,0" FontSize="12" />
          <Button Grid.Column="2" Content="Показать в папке" Click="RevealButton_Click" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
