<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>QuickPreview</AssemblyName>
    <RootNamespace>QuickPreview</RootNamespace>
    <Version>1.3.10</Version>
    <PlatformTarget>x64</PlatformTarget>
    <Authors>QuickPreview</Authors>
    <Product>QuickPreview</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\quickpreview.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="assets\quickpreview.ico" />
    <Resource Include="assets\quickpreview-tray.ico" />
    <Resource Include="assets\quickpreview-128.png" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" GeneratePathProperty="true" />
    <PackageReference Include="SharpCompress" Version="0.50.9" />
    <PackageReference Include="Magick.NET-Q8-x64" Version="15.0.0" />
    <PackageReference Include="ACadSharp" Version="3.6.51" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="MsgReader" Version="6.0.3" />
    <PackageReference Include="OpenMcdf" Version="3.3.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="RtfPipe" Version="2.0.7677.4303" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.5" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="ExcelNumberFormat" Version="1.2.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- WebView2 resolves its native loader by path. Keep this DLL next to the
         single-file executable, and include it in the installer payload. -->
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
             Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="artifacts\**\*.cs" />
    <Content Include="assets\model-viewer\**\*" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="assets\spreadsheet-viewer\**\*" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="assets\licenses\**\*" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="THIRD-PARTY-NOTICES.md;SUPPORTED_FORMATS.md" CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- The single-file SDK can merge the package's duplicate native asset even
       when Content.ExcludeFromSingleFile is set. Copy the loader after bundling. -->
  <Target Name="PublishWebView2Loader" AfterTargets="Publish">
    <Copy SourceFiles="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
          DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
